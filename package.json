    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "terser": "^5.43.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
