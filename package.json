    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.8.0",
    "@vercel/analytics": "^1.5.0",
    "d3-shape": "3.2.0",
    "i18next": "^25.3.2",
    "luxon": "^3.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-is": "^18.2.0",
    "react-router-dom": "^7.7.0",
    "recharts": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/luxon": "^3.7.2",
