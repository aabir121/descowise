{
  "name": "descowise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "deploy:win": "scripts\\deploy.bat",
    "test": "vitest run services/pushNotificationService.test.ts workers/notifications/src/schedule.test.ts",
    "worker:dev": "wrangler dev --config workers/notifications/wrangler.toml --local",
    "worker:deploy": "wrangler deploy --config workers/notifications/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply descowise-notifications --local --config workers/notifications/wrangler.toml",
    "worker:migrate": "wrangler d1 migrations apply descowise-notifications --remote --config workers/notifications/wrangler.toml"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@dnd-kit/core": "^6.3.1",
